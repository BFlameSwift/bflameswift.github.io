[Unit]
Description=Refresh validated public Google Scholar citation counts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/me-scholar-citations/update.py --output /var/www/me.bflame.top/shared/stats/scholar.json
TimeoutStartSec=60
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/me.bflame.top/shared/stats
